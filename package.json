{
  "name": "the-loop",
  "version": "1.0.0",
  "description": "The Loop — a daily word-ring puzzle: game client, puzzle engine, and publishing pipeline",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "node engine/generate.mjs",
    "validate": "node engine/validate.mjs",
    "publish-daily": "node scripts/publish.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 8080 -d site"
  },
  "engines": {
    "node": ">=20"
  }
}
